/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://huggingface.co https://api.github.com; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

/app.js
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
