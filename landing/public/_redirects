# OAuth callback paths are the page itself: the code and state arrive as query parameters and
# app.js finishes the sign-in wherever it lands. Covers whatever callback path the OAuth apps were
# registered with, as long as it is under this origin.
/auth/*            /index.html  200
/callback          /index.html  200
/callback/*        /index.html  200
/login/*           /index.html  200
/oauth/*           /index.html  200
/api/auth/github/callback  /index.html  200
/api/auth/hf/callback      /index.html  200
